# Copy to .env and fill in the keys you have. Each source is optional:
# a source without keys is simply left out of search. Adding by link always works.

# YouTube Data API v3 key (free): https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# SoundCloud app (registration requires Artist Pro): https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Spotify app (owner needs Premium since Feb 2026): https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# PostgreSQL from docker compose (npm run db:up). Without STORAGE=postgres the server uses in-memory static data
STORAGE=postgres
DATABASE_URL=postgres://vv:vv@localhost:55432/vv
